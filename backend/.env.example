# ============================================================================
# SECRETOS del backend en desarrollo. Solo secretos: lo que no lo es (entorno,
# usuarios, nombres de base, direcciones) va fijo en docker-compose.dev.yml.
#   cp backend/.env.example backend/.env    y cambia TODO.
# "cambiame" o una clave corta cuentan como ausentes: la API no arranca.
# (Producción: salen de los Secrets de GitHub; ver docs/deploy-config-REFERENCIA.md.)
# ============================================================================

# Postgres: contraseña del dueño de las tablas (migraciones). Mínimo 16 caracteres.
POSTGRES_PASSWORD=cambiame
# Contraseña del usuario de la API (privilegio mínimo). Mínimo 16 caracteres.
API_DB_CLAVE=cambiame
# Firma de las sesiones del panel. Mínimo 32 caracteres aleatorios:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambiame
# De ella se deriva el secreto de webhooks de cada sitio web (PLAN-BACKEND §4.4).
# Mínimo 32 caracteres aleatorios (mismo comando). Cambiarla obliga a darle a
# cada sitio su secreto nuevo.
CLAVE_WEBHOOKS=cambiame
# OPCIONAL. El bot que busca dónde aparece el hotel (API de Brave Search, de
# pago por consulta). Sin ella, el bot no busca y lo dice en el panel.
# BRAVE_SEARCH_CLAVE=
