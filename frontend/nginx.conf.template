# Plantilla: la imagen oficial de Nginx corre envsubst al arrancar y deja el
# resultado en /etc/nginx/conf.d/default.conf. NGINX_ENVSUBST_FILTER=^BEACHCLUB_
# (Dockerfile) hace que SOLO se sustituyan nuestras variables: sin el filtro,
# envsubst vaciaría también $host, $uri, $request_uri… y la config quedaría rota.

server_tokens off;

# Microcaché de la API pública v1 (PLAN-BACKEND §12). La API decide cuánto con
# `X-Accel-Expires` (catálogo 60 s, disponibilidad 5 s); sin esa cabecera, o con
# Set-Cookie, no se guarda nada.
proxy_cache_path /var/cache/nginx/api levels=1:2 keys_zone=api_v1:20m
                 max_size=256m inactive=10m use_temp_path=off;

# ── 80: renovación de Let's Encrypt (webroot) y redirección a HTTPS ──────────
server {
    listen 80;
    server_name ${BEACHCLUB_DOMINIO};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── 443: la SPA ──────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${BEACHCLUB_DOMINIO};

    # /etc/letsencrypt del host montado tal cual (solo lectura): la renovación
    # no necesita copiar certificados, basta un `nginx -s reload`.
    ssl_certificate     /etc/letsencrypt/live/${BEACHCLUB_DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BEACHCLUB_DOMINIO}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Ningún `location` de abajo lleva add_header: si uno lo llevara, Nginx
    # descartaría TODOS estos en ese location. La caché va con `expires`.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    root  /usr/share/nginx/html;
    index index.html;

    # Rutas de React Router (/admin/…) caen en index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite pone hash en todo lo de /assets/: se puede cachear un año.
    location /assets/ {
        expires 1y;
    }

    # index.html nunca en caché: es lo que apunta a los assets nuevos.
    location = /index.html {
        expires -1;
    }

    # ── Fotos de las habitaciones (docs/PLAN-BACKEND.md §18) ──
    # Del volumen `fotos`, montado SOLO LECTURA. Solo se sirve lo que tiene la
    # forma exacta que genera la API (<uuid>/<uuid>/<uuid>-<ancho>.webp): nada de
    # listados, de archivos temporales (.tmp) ni de otra cosa que caiga ahí.
    # Nginx nunca ejecuta nada de esa carpeta. El nombre cambia si cambia la
    # foto, así que se cachea largo.
    location ~ "^/media/fotos/([0-9a-f-]{36}/[0-9a-f-]{36}/[0-9a-f-]{36}-(480|1080|1920)\.webp)$" {
        alias /datos/fotos/$1;
        limit_except GET { deny all; }
        expires 30d;
    }
    location /media/ {
        return 404;
    }

    # ── API (FastAPI) ──
    # Resolver de Docker y destino en variable: Nginx busca `api` en CADA
    # petición, no solo al arrancar. Así arranca aunque el backend aún no esté
    # desplegado (responde 502 en /api) y no se queda con la IP vieja cuando la
    # API se recrea (la trampa de docs/deploy-config-REFERENCIA.md §7).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api http://api:8000;

    location /api/ {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        # SOBRESCRIBIR, nunca $proxy_add_x_forwarded_for: la API toma de aquí la
        # IP para la auditoría forense y el límite de intentos (PLAN-BACKEND §17.4).
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        client_max_body_size 1m;
    }

    # API pública de las websites. El Origin y la clave pública van en la llave:
    # la respuesta lleva el Access-Control-Allow-Origin de ESE sitio y solo sus
    # propiedades. Con clave secreta (Authorization) nunca se cachea: ni se guarda
    # ni entra a la llave. 500 peticiones iguales = 1 al backend (cache_lock).
    location /api/v1/ {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        client_max_body_size 1m;
        proxy_cache api_v1;
        proxy_cache_key $scheme$host$request_uri$http_origin$http_x_frida_clave;
        proxy_cache_methods GET HEAD;
        proxy_cache_bypass $http_authorization;
        proxy_no_cache $http_authorization;
        proxy_cache_lock on;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
    }

    # Avisos en vivo (SSE, PLAN-BACKEND §10): sin búfer ni caché, conexión larga.
    # La API corta cada 10 min a propósito y el navegador reconecta solo.
    location = /api/eventos {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Subir una foto: hasta 15 MB (la API lo vuelve a comprobar).
    location ~ "^/api/admin/habitaciones/[0-9a-f-]{36}/fotos$" {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        client_max_body_size 16m;
        proxy_read_timeout 120s;
    }
}
